# Public API origin used by the browser. Set this to the deployed API URL.
# Do not put secrets or database credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8000

# OpenID Connect public client (Authorization Code + PKCE)
NEXT_PUBLIC_OIDC_AUTHORITY=https://identity.example.com
NEXT_PUBLIC_OIDC_CLIENT_ID=carbon-esg-web
