# API runtime
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://carbon_esg_app:replace-with-strong-password@localhost:5432/carbon_esg
# Use a separate database-owner credential only for Alembic migrations and controlled admin tasks.
MIGRATION_DATABASE_URL=postgresql+psycopg://carbon_esg_migrator:replace-with-migration-password@localhost:5432/carbon_esg

# Comma-separated explicit browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# OIDC resource-server validation. Use the issuer and audience from your provider.
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=carbon-esg-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Private S3-compatible evidence storage. Use a private bucket with public access blocked.
S3_ENDPOINT_URL=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=carbon-esg-evidence
S3_ACCESS_KEY_ID=replace-with-secret
S3_SECRET_ACCESS_KEY=replace-with-secret
S3_SERVER_SIDE_ENCRYPTION=AES256
# For AWS KMS, set S3_SERVER_SIDE_ENCRYPTION=aws:kms and provide a key ID.
S3_KMS_KEY_ID=

# Private ClamAV daemon network endpoint. Uploads fail closed if scanner is unavailable.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
