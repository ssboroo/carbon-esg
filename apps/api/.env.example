# Exact comma-separated browser origins. Never use wildcard CORS.
CORS_ORIGINS=http://localhost:3000
# Neon Managed Better Auth URLs (public metadata, not secrets).
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Neon pooled connection for runtime queries (set only in the API host secret store).
DATABASE_URL=
# Neon direct/unpooled connection for Alembic migrations; do not use the pooler.
DATABASE_URL_UNPOOLED=

# Private evidence object storage. Keep bucket private and credentials server-only.
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
# Private ClamAV daemon reachable only from the API service.
CLAMAV_HOST=
CLAMAV_PORT=3310
ENVIRONMENT=development
