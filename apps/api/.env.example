# API runtime
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/carbon_esg

# Comma-separated explicit browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# OIDC resource-server validation. Use the issuer and audience from your provider.
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=carbon-esg-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
