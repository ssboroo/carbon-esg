# API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://carbon_esg_app:CHANGE_ME@localhost:5432/carbon_esg
CORS_ORIGINS=http://localhost:3000

# OIDC Resource Server — configure with your identity provider's exact values.
# The API validates RS256 access tokens against the provider's HTTPS JWKS endpoint.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Do not use ID tokens as API access tokens. Provision users by trusted (issuer, subject)
# identity pair and assign organization memberships out of band.
